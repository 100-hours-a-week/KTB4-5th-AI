APP_ENV=local
INTERNAL_API_KEY=change-me
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14

# 큐 항목은 이미지 바이트 없이 objectKey만 들고 있어 가볍다. 초과 요청은 AI_QUEUE_FULL로 거절한다.
ANALYSIS_QUEUE_MAXSIZE=100
# 동시에 처리할 분석 수. 추론은 GPU Worker가 직렬로 처리하므로 크게 늘려도 Worker 대기만 길어진다.
ANALYSIS_CONSUMER_COUNT=2
ANALYSIS_RESULT_TTL_SECONDS=3600
ANALYSIS_RESULT_MAX_ENTRIES=1000
ANALYSIS_RETRY_COUNT=1
ANALYSIS_RETRY_DELAY_SECONDS=1

# 이미지 다운로드·입력 유형 분류·OCR·Gemma 추론은 모두 RunPod GPU Worker가 맡는다.
# 고정 URL을 쓰거나, Runpod API로 현재 실행 중인 <prefix>-vN Worker를 자동 탐색한다.
REMOTE_INFERENCE_URL=
REMOTE_INFERENCE_API_KEY=
REMOTE_INFERENCE_TIMEOUT_SECONDS=180
RUNPOD_API_KEY=
RUNPOD_POD_NAME_PREFIX=dameokja-ai-worker
# 같은 prefix를 쓰는 Pod가 여럿이면 template까지 제한한다. 필요 없으면 비워둔다.
RUNPOD_TEMPLATE_ID=
RUNPOD_WORKER_PORT=9000
RUNPOD_DISCOVERY_TTL_SECONDS=60
# IMAGE_SOURCE=local인 개발 환경에서 Worker가 이미지를 받을 기준 URL. 운영 S3는 objectKey로 서명 URL을 생성한다.
REMOTE_IMAGE_BASE_URL=

# s3: 고정 버킷의 objectKey를 서명 URL로 Worker에 전달, local: REMOTE_IMAGE_BASE_URL 아래 objectKey를 전달
IMAGE_SOURCE=local
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ALLOWED_PREFIX=uploads/

# 응답 modelTrace에 기록하는 Worker 모델 버전. Worker 구성을 바꾸면 함께 맞춘다.
OLLAMA_MODEL=gemma4:e2b
INPUT_CLASSIFIER_VERSION=mobilenetv3-small-input-type-v1

# 비워두면 유통기한·상품 카탈로그 조회를 비활성화한다(shelf_life_rules/product_knowledge 미사용).
DATABASE_URL=
# 레시피 외부 검색은 키와 원문 저장·재배포 조건 확인이 모두 필요하다.
RECIPE_CACHE_TTL_SECONDS=300
# 기존 Worker 주소·X-Worker-API-Key를 재사용한다. 꺼짐/오류 시 RULE_FALLBACK을 명시한다.
RECIPE_AI_ENABLED=true
# 계획·선택·LLM 슬롯 대기를 합친 예산. DB·외부 원천 시간까지 포함한 API SLA가 아니다.
RECIPE_AI_TIMEOUT_SECONDS=45
RECIPE_AI_RANK_TIMEOUT_SECONDS=20
RECIPE_AI_INPUT_MAX_BYTES=16000
RECIPE_AI_MAX_CANDIDATES=20
# 영수증 큐와 분리한 레시피 전용 비동기 큐/소비자. 최대 추천 수는 10개다.
RECIPE_QUEUE_MAXSIZE=100
RECIPE_CONSUMER_COUNT=2
RECIPE_JOB_TIMEOUT_SECONDS=120
RECIPE_RESULT_TTL_SECONDS=3600
RECIPE_RESULT_MAX_ENTRIES=2000
# 레시피 전용 백엔드 수신 URL/키. 영수증 CALLBACK_URL로 대신 보내지 않는다.
RECIPE_CALLBACK_URL=
RECIPE_CALLBACK_API_KEY=
RECIPE_FOOD_SAFETY_API_KEY=
RECIPE_KOREAN_ARCHIVE_API_KEY=
RECIPE_FOOD_SAFETY_STORAGE_APPROVED=false
# 미활용 임박 주재료/취향 후보가 부족하면 전체 웹 검색. 검증된 원문만 추천한다.
TAVILY_API_KEY=
# 본문 저장·가공·서비스 제공 조건을 확인한 정확한 호스트를 JSON 배열로 지정한다.
# 검색 제한 목록이 아니라 원천 DB 재사용 등록 승인 호스트다. 빈 목록이어도 검색한다.
RECIPE_TAVILY_APPROVED_DOMAINS=[]
# 기본 1회 호출, 시간 초과·5xx 자동 재시도 없음. 2이면 429만 한 번 재시도한다.
RECIPE_TAVILY_MAX_ATTEMPTS=1
DATABASE_POOL_MAX_SIZE=5
# 유통기한·상품 카탈로그 조회 결과(없음 포함)를 캐싱하는 최대 항목 수.
REFERENCE_CACHE_MAX_SIZE=2000
# 다른 FastAPI 프로세스에서 갱신된 개인 보정 지식을 다시 읽는 최대 지연 시간(초).
PRODUCT_CATALOG_CACHE_TTL_SECONDS=60
# 상품 카탈로그 정확 일치가 없을 때 pg_trgm 유사도 폴백을 적용할 최소 유사도(0~1).
CATALOG_FUZZY_SIMILARITY_THRESHOLD=0.4

# 백엔드 콜백 수신 주소와 AI→BE 인증 키. production에서는 둘 다 필수다.
# 로컬 개발에서만 비워두고 GET으로 결과를 확인할 수 있다.
# 운영 예: https://<backend>/api/v1/internal/image-analyses/callback
CALLBACK_URL=
CALLBACK_API_KEY=
CALLBACK_TIMEOUT_SECONDS=5
CALLBACK_MAX_ATTEMPTS=3

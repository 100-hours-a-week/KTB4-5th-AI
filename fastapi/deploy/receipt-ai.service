[Unit]
Description=KTB Receipt AI FastAPI
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/dameokja/fastapi
EnvironmentFile=/home/ec2-user/dameokja/fastapi/.env
ExecStart=/home/ec2-user/dameokja/fastapi/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target

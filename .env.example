APP_ENV=local
INTERNAL_API_KEY=change-me
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14

# 큐 항목은 이미지 바이트 없이 objectKey만 들고 있어 가볍다 — 컨슈머 1개·평균 처리 13초
# 기준으로 16개는 3분치 버퍼밖에 안 돼서 40으로 늘렸다.
ANALYSIS_QUEUE_MAXSIZE=40
# 분석을 동시에 몇 개까지 처리할지(OCR 자체는 메모리 문제로 여전히 1개씩만 처리하지만, 그
# 앞뒤 단계가 겹칠 수 있게 된다). 실측: 부하 시 큐 대기 127초 중 실제 처리는 13.6초뿐이었다.
# EC2가 4코어에 Ollama도 CPU 추론이라, 3으로 돌리면 오히려 건당 처리시간이 3~6배 느려져서
# (평균 32.8초, 최대 79.7초) 2로 낮췄다 — 코어 수보다 늘리면 서로 CPU를 뺏는다.
ANALYSIS_CONSUMER_COUNT=2
ANALYSIS_RESULT_TTL_SECONDS=3600
ANALYSIS_RESULT_MAX_ENTRIES=1000
MAX_IMAGE_BYTES=15728640
MAX_IMAGE_PIXELS=40000000

# local: LOCAL_IMAGE_ROOT 아래 objectKey를 읽음, s3: 고정 버킷에서 읽음
IMAGE_SOURCE=local
LOCAL_IMAGE_ROOT=./var/uploads
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ALLOWED_PREFIX=uploads/

OCR_BACKEND=paddle
PADDLE_LANG=korean
PADDLE_OCR_VERSION=PP-OCRv5
PADDLE_DEVICE=cpu
PADDLE_ENABLE_MKLDNN=false
# 실영수증 3장으로 검증: 줄글자 방향(텍스트라인 회전) 분류를 꺼도 식품/상품 줄 손실이
# 없었고 5~9% 더 빨랐다. 기울어진 사진이 많아지면 재검증 후 true로 되돌릴 것.
PADDLE_USE_TEXTLINE_ORIENTATION=false
# 비워두면 HPI(고성능 추론)를 쓰지 않는다. "onnxruntime"으로 설정하면 text_detection/
# text_recognition 두 모델만 ONNX Runtime으로 강제 실행해 실영수증 3장 기준 추가로
# 8~48% 더 빨라졌다(내용 손실 없음, diff로 검증). 나머지 단계(문서방향/왜곡보정/
# 텍스트줄방향)는 그대로 둔다 — enable_hpi 전체 자동 선택은 PP-OCRv5_server_det에서
# PADDLE_ENABLE_MKLDNN=true와 동일한 oneDNN/PIR 크래시가 나서(paddle 3.3.1 확인) 쓰지 않는다.
# 사용 전 `paddleocr install_hpi_deps cpu`로 의존성을 설치해야 한다(venv에 pip 모듈 필요).
PADDLE_HPI_BACKEND=onnxruntime
# onnxruntime 백엔드는 이미지 크기가 바뀔 때마다 내부 메모리 아레나가 커지고 줄지 않는다
# (실측: 요청 10개 연속 처리에 +6.6GB, EC2에서 OOM으로 프로세스가 죽은 적 있음). 이 값만큼
# OCR 요청을 처리하면 엔진을 버리고 다음 요청에서 새로 만들어 메모리를 회수한다(실측:
# 6.6GB→522MB, 서비스 중단 없음). 0 이하면 리사이클을 끈다.
PADDLE_ENGINE_RECYCLE_AFTER=25
# 이미지 크기 편차가 크면 개수만으로는 위험하다(실측: 5번째 요청만에 6.5GB 초과). 매 요청 뒤
# 실제 RSS(MB)가 이 값을 넘으면 개수와 무관하게 즉시 리사이클한다 — 둘 중 먼저 도달하는 쪽을 따른다.
PADDLE_ENGINE_RECYCLE_RSS_MB=6000

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_PREDICT=512
# 요청 사이 간격이 뜨면 Ollama가 모델을 언로드해 다음 요청이 콜드스타트로 느려진다.
# 모델(약 6.7GB)을 이 시간 동안 계속 메모리에 유지한다.
OLLAMA_KEEP_ALIVE=30m

# 비워두면 유통기한·상품 카탈로그 조회를 비활성화한다(shelf_life_rules/product_knowledge 미사용).
DATABASE_URL=
DATABASE_POOL_MAX_SIZE=5
# 유통기한·상품 카탈로그 조회 결과(없음 포함)를 캐싱하는 최대 항목 수.
REFERENCE_CACHE_MAX_SIZE=2000
# 상품 카탈로그 정확 일치가 없을 때 pg_trgm 유사도 폴백을 적용할 최소 유사도(0~1).
CATALOG_FUZZY_SIMILARITY_THRESHOLD=0.4

# 비워두면 콜백을 보내지 않고 GET으로만 로컬 확인 가능
CALLBACK_URL=
CALLBACK_API_KEY=
CALLBACK_TIMEOUT_SECONDS=5
CALLBACK_MAX_ATTEMPTS=3

# RunPod에는 이 파일을 .env로 복사하고 빈 값을 실제 값으로 채운다.
APP_ENV=production
APP_ROLE=worker
LOG_LEVEL=INFO
# Runpod처럼 환경변수를 직접 주입하는 배포에서는 false로 설정한다.
LOAD_DOTENV=true

# EC2의 REMOTE_INFERENCE_API_KEY와 반드시 같은 임의의 긴 값을 사용한다.
WORKER_API_KEY=
# Worker가 이미지를 내려받을 S3/CDN/EC2 호스트를 정확히 쉼표로 나열한다.
# 예: my-bucket.s3.ap-northeast-2.amazonaws.com
WORKER_ALLOWED_IMAGE_HOSTS=
WORKER_ALLOW_PRIVATE_IMAGE_URLS=false
WORKER_DOWNLOAD_TIMEOUT_SECONDS=30
WORKER_ENABLE_LLM=true
WORKER_MAX_CONCURRENCY=2
WORKER_OCR_MAX_CONCURRENCY=1
WORKER_LLM_MAX_CONCURRENCY=1
# 실물 상품은 OCR과 Gemma가 독립적이므로 겹쳐 실행한다. GPU 경합이 심하면 false로 A/B 비교한다.
WORKER_PRODUCT_PARALLEL_INFERENCE=true
WORKER_PRODUCT_DETECTOR_BACKEND=yolo_world
WORKER_PRODUCT_DETECTOR_MODEL_PATH=/workspace/models/yolov8s-worldv2.pt
WORKER_PRODUCT_SEGMENTER_MODEL_PATH=/workspace/models/yoloe-11s-seg.pt
WORKER_PRODUCT_DETECTOR_CLASSES=food package,snack bag,food box,instant noodles,sausage
WORKER_PRODUCT_DETECTOR_CONFIDENCE=0.02
WORKER_PRODUCT_DETECTOR_IOU=0.70
WORKER_PRODUCT_DETECTOR_IMAGE_SIZE=1280
WORKER_PRODUCT_DETECTOR_MAX_DETECTIONS=24
WORKER_PRODUCT_CROP_CONCURRENCY=2
WORKER_RECEIPT_OCR_MIN_LONG_EDGE=1280
WORKER_RECEIPT_OCR_TILING=true
WORKER_RECEIPT_OCR_TILE_HEIGHT_RATIO=0.55
WORKER_RECEIPT_OCR_TILE_OVERLAP_RATIO=0.15
WORKER_RECEIPT_OCR_TILE_MIN_CONFIDENCE=0.75
PADDLE_DET_THRESH=0.3
PADDLE_DET_BOX_THRESH=0.6
PADDLE_DET_UNCLIP_RATIO=1.5

OCR_BACKEND=paddle
PADDLE_LANG=korean
PADDLE_OCR_VERSION=PP-OCRv5
PADDLE_DEVICE=gpu:0
WORKER_MPLBACKEND=Agg
PADDLE_ENABLE_MKLDNN=false
PADDLE_USE_TEXTLINE_ORIENTATION=false
PADDLE_USE_DOC_ORIENTATION_CLASSIFY=false
PADDLE_USE_DOC_UNWARPING=true
# CPU ONNX HPI 우회는 EC2 CPU 최적화용이다. GPU Worker에서는 Paddle GPU 경로를 사용한다.
PADDLE_HPI_BACKEND=
PADDLE_ORT_DISABLE_ARENA=false
PADDLE_ENGINE_RECYCLE_AFTER=0
PADDLE_ENGINE_RECYCLE_RSS_MB=0

# 저장소의 검증 완료 체크포인트를 /workspace/models에 복사한다. 파일이 없으면 자동 폴백한다.
INPUT_CLASSIFIER_BACKEND=auto
INPUT_CLASSIFIER_MODEL_PATH=/workspace/models/input-type-mobilenetv3-small.onnx
INPUT_CLASSIFIER_LABELS=OTHER,PRODUCT,RECEIPT
INPUT_CLASSIFIER_MIN_CONFIDENCE=0.80
INPUT_CLASSIFIER_MIN_MARGIN=0.20
INPUT_CLASSIFIER_CPU_THREADS=1
INPUT_CLASSIFIER_VERSION=mobilenetv3-small-input-type-v1

OLLAMA_HOST=127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_MODELS=/workspace/ollama
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=30m
PULL_MODEL_ON_START=true
WARM_MODEL_ON_START=true
REQUIRE_GPU=true
WORKER_PORT=9000
